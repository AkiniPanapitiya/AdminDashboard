# Copy this file to ".env" and adjust. NEVER commit the real .env file.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://inka:inka_dev_password@localhost:5432/inka
# Used only by automated tests. The database name MUST end in "_test" (tests wipe it).
TEST_DATABASE_URL=postgres://inka:inka_dev_password@localhost:5432/inka_test

# --- API server ---
NODE_ENV=development
PORT=4000
# The exact browser origin of the web app (used for CSRF protection).
# Development: Vite dev server. Production: your https:// site address.
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BUSINESS_TZ=Asia/Colombo
LOG_LEVEL=info

# --- Production only ---
# COOKIE_SECURE is forced to true in production. Serve the site over HTTPS.
# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Caddy), so client IPs are correct.
# TRUST_PROXY=1
# Serve the built web app from the API on one origin (set automatically in the Docker image).
# CLIENT_DIST=/app/client/dist
